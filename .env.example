PURPLELAB_APP_NAME=PurpleLab
PURPLELAB_ENVIRONMENT=development
PURPLELAB_DEBUG=true
PURPLELAB_DATABASE_URL=postgresql+asyncpg://purplelab:purplelab@localhost:5432/purplelab
PURPLELAB_DATABASE_URL_SYNC=postgresql://purplelab:purplelab@localhost:5432/purplelab
PURPLELAB_FIXTURE_PATH=fixtures
PURPLELAB_SCENARIOS_DIR=scenarios
PURPLELAB_RULES_DIR=rules/sigma
PURPLELAB_EXECUTION_TIMEOUT_SECONDS=60
PURPLELAB_MAX_EVENTS_PER_EXECUTION=500
PURPLELAB_REQUIRE_APPROVAL=false
PURPLELAB_DEFAULT_COLLECTOR=fixture
PURPLELAB_COLLECTOR_VERIFY_TLS=true
PURPLELAB_COLLECTOR_TIMEOUT_SECONDS=20
PURPLELAB_MAX_COLLECTOR_EVENTS=500
PURPLELAB_ELASTIC_ENDPOINT=
PURPLELAB_ELASTIC_API_KEY=
PURPLELAB_ELASTIC_EVENTS_INDEX=logs-*
PURPLELAB_ELASTIC_ALERTS_INDEX=.alerts-security.alerts-*
PURPLELAB_SPLUNK_ENDPOINT=
PURPLELAB_SPLUNK_TOKEN=
PURPLELAB_SENTINEL_WORKSPACE_ID=
PURPLELAB_SENTINEL_TOKEN=
PURPLELAB_SENTINEL_ENDPOINT=https://api.loganalytics.io/v1
PURPLELAB_SYSMON_EVTX_PATH=
PURPLELAB_ZEEK_LOG_DIR=
PURPLELAB_SURICATA_EVE_PATH=